// 분석기 검증용 그래프. 이름·ID 는 prod 실제 값 (plan fixture 와 맞추기 위함), 정책 문장은 10/13 수집 그래프와 같다.
CREATE (cf:AWSCloudFrontDistribution {id: 'arn:aws:cloudfront::794386801311:distribution/EYTWHIBCVO5FY', arn: 'arn:aws:cloudfront::794386801311:distribution/EYTWHIBCVO5FY', enabled: true})
CREATE (dns:AWSDNSRecord {id: 'origin.re-used.store+ALIAS', name: 'origin.re-used.store', type: 'ALIAS'})
CREATE (nlb:AWSLoadBalancerV2 {id: 'logssey-prod-nlb-public', name: 'logssey-prod-nlb-public', dnsname: 'logssey-prod-nlb-public-a37c39e077808af2.elb.ap-northeast-1.amazonaws.com', scheme: 'internet-facing'})
CREATE (w0:AWSEC2Instance {id: 'i-030605b5b05e1eb94', instanceid: 'i-030605b5b05e1eb94', privateipaddress: '10.20.10.20', metadatahttptokens: 'optional', metadatahttpendpoint: 'enabled'})
CREATE (w1:AWSEC2Instance {id: 'i-08aa421a354dcf78a', instanceid: 'i-08aa421a354dcf78a', privateipaddress: '10.20.11.20', metadatahttptokens: 'optional', metadatahttpendpoint: 'enabled'})
CREATE (w2:AWSEC2Instance {id: 'i-0c18628fa30035aa9', instanceid: 'i-0c18628fa30035aa9', privateipaddress: '10.20.12.20', metadatahttptokens: 'optional', metadatahttpendpoint: 'enabled'})
CREATE (profile:AWSInstanceProfile {id: 'arn:aws:iam::794386801311:instance-profile/logssey-prod-instance-profile-node'})
CREATE (role:AWSRole:AWSPrincipal {id: 'arn:aws:iam::794386801311:role/logssey-prod-role-node', arn: 'arn:aws:iam::794386801311:role/logssey-prod-role-node', name: 'logssey-prod-role-node'})
CREATE (deny:AWSPolicy:AWSInlinePolicy {id: 'arn:aws:iam::794386801311:role/logssey-prod-role-node/inline_policy/logssey-prod-deny-tfstate', name: 'logssey-prod-deny-tfstate', type: 'inline'})
CREATE (denyS:AWSPolicyStatement {id: 'deny-1', effect: 'Deny', action: ['s3:*'], resource: ['arn:aws:s3:::logssey-prod-s3-tfstate', 'arn:aws:s3:::logssey-prod-s3-tfstate/*']})
CREATE (s3access:AWSPolicy:AWSInlinePolicy {id: 'arn:aws:iam::794386801311:role/logssey-prod-role-node/inline_policy/logssey-prod-s3-access', name: 'logssey-prod-s3-access', type: 'inline'})
CREATE (s3accessS:AWSPolicyStatement {id: 's3-1', effect: 'Allow', action: ['s3:PutObject', 's3:GetObject', 's3:DeleteObject'], resource: ['arn:aws:s3:::logssey-prod-s3-images/*', 'arn:aws:s3:::logssey-prod-loki-ruler/*', 'arn:aws:s3:::logssey-prod-loki-chunks/*']})
CREATE (secrets:AWSPolicy:AWSInlinePolicy {id: 'arn:aws:iam::794386801311:role/logssey-prod-role-node/inline_policy/logssey-prod-secrets-read', name: 'logssey-prod-secrets-read', type: 'inline'})
CREATE (secretsS:AWSPolicyStatement {id: 'sec-1', effect: 'Allow', action: ['secretsmanager:GetSecretValue', 'secretsmanager:DescribeSecret'], resource: ['arn:aws:secretsmanager:ap-northeast-1:794386801311:secret:*']})
CREATE (s3full:AWSPolicy:AWSManagedPolicy {id: 'arn:aws:iam::aws:policy/AmazonS3FullAccess', name: 'AmazonS3FullAccess', type: 'managed'})
CREATE (s3fullS:AWSPolicyStatement {id: 's3full-1', effect: 'Allow', action: ['s3:*', 's3-object-lambda:*'], resource: ['*']})
CREATE (secret:AWSSecretsManagerSecret {id: 'arn:aws:secretsmanager:ap-northeast-1:794386801311:secret:reused/prod/api-ONfjwj', arn: 'arn:aws:secretsmanager:ap-northeast-1:794386801311:secret:reused/prod/api-ONfjwj', name: 'reused/prod/api'})
CREATE (images:AWSS3Bucket {id: 'logssey-prod-s3-images', arn: 'arn:aws:s3:::logssey-prod-s3-images', name: 'logssey-prod-s3-images'})
CREATE (tfstate:AWSS3Bucket {id: 'logssey-prod-s3-tfstate', arn: 'arn:aws:s3:::logssey-prod-s3-tfstate', name: 'logssey-prod-s3-tfstate'})
CREATE (dns)-[:DNS_POINTS_TO]->(nlb)
CREATE (nlb)-[:EXPOSE {port: 30080}]->(w0)
CREATE (nlb)-[:EXPOSE {port: 30080}]->(w1)
CREATE (nlb)-[:EXPOSE {port: 30080}]->(w2)
CREATE (w0)-[:INSTANCE_PROFILE]->(profile)
CREATE (w1)-[:INSTANCE_PROFILE]->(profile)
CREATE (w2)-[:INSTANCE_PROFILE]->(profile)
CREATE (profile)-[:ASSOCIATED_WITH]->(role)
CREATE (role)-[:POLICY]->(deny)
CREATE (role)-[:POLICY]->(s3access)
CREATE (role)-[:POLICY]->(secrets)
CREATE (role)-[:POLICY]->(s3full)
CREATE (deny)-[:STATEMENT]->(denyS)
CREATE (s3access)-[:STATEMENT]->(s3accessS)
CREATE (secrets)-[:STATEMENT]->(secretsS)
CREATE (s3full)-[:STATEMENT]->(s3fullS)
// Cartography 권한 매핑 결과 (거부가 반영되어 tfstate 는 없음)
CREATE (role)-[:CAN_READ]->(secret)
CREATE (role)-[:CAN_READ]->(images)
