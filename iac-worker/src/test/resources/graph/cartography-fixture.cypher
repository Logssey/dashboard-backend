// Cartography 0.143.0 그래프를 줄인 fixture. 라벨·속성·관계 방향은 10/13 수집 결과(로컬 Neo4j)와 같다.
CREATE (cf:AWSCloudFrontDistribution:CloudFrontDistribution {id: 'arn:aws:cloudfront::111122223333:distribution/MAIN', arn: 'arn:aws:cloudfront::111122223333:distribution/MAIN', enabled: true, aliases: ['re-used.store']})
CREATE (cfOff:AWSCloudFrontDistribution:CloudFrontDistribution {id: 'arn:aws:cloudfront::111122223333:distribution/OFF', arn: 'arn:aws:cloudfront::111122223333:distribution/OFF', enabled: false})
CREATE (dns:AWSDNSRecord:DNSRecord {id: 'origin.re-used.store+ALIAS', name: 'origin.re-used.store', type: 'ALIAS'})
CREATE (nlb:AWSLoadBalancerV2:LoadBalancerV2 {id: 'nlb-public', name: 'logssey-prod-nlb-public', dnsname: 'nlb-public.elb.amazonaws.com', scheme: 'internet-facing', type: 'network'})
CREATE (internal:AWSLoadBalancerV2:LoadBalancerV2 {id: 'nlb-internal', name: 'logssey-prod-nlb-internal-api', dnsname: 'nlb-internal.elb.amazonaws.com', scheme: 'internal', type: 'network'})
CREATE (listener:AWSELBV2Listener:ELBV2Listener {id: 'listener-443', port: 443, protocol: 'TLS'})
CREATE (sg:AWSEC2SecurityGroup:EC2SecurityGroup {id: 'sg-public-nlb', name: 'logssey-prod-sg-public-nlb'})
CREATE (egress:IpPermissionEgress:IpRule {id: 'sg-public-nlb/egress/-1', protocol: '-1'})
CREATE (anywhere:AWSIpRange:IpRange {id: '0.0.0.0/0'})
CREATE (w1:AWSEC2Instance:EC2Instance:ComputeInstance {id: 'i-worker1', instanceid: 'i-worker1', privateipaddress: '10.20.10.20', metadatahttptokens: 'optional', metadatahttpendpoint: 'enabled'})
CREATE (w2:AWSEC2Instance:EC2Instance:ComputeInstance {id: 'i-worker2', instanceid: 'i-worker2', privateipaddress: '10.20.11.20', metadatahttptokens: 'required', metadatahttpendpoint: 'enabled'})
CREATE (cp:AWSEC2Instance:EC2Instance:ComputeInstance {id: 'i-cp1', instanceid: 'i-cp1', privateipaddress: '10.20.10.10', metadatahttptokens: 'optional', metadatahttpendpoint: 'enabled'})
CREATE (profile:AWSInstanceProfile {id: 'arn:aws:iam::111122223333:instance-profile/node', arn: 'arn:aws:iam::111122223333:instance-profile/node'})
CREATE (role:AWSRole:AWSPrincipal:PermissionRole {id: 'arn:aws:iam::111122223333:role/logssey-prod-role-node', arn: 'arn:aws:iam::111122223333:role/logssey-prod-role-node', name: 'logssey-prod-role-node'})
CREATE (secret:AWSSecretsManagerSecret:SecretsManagerSecret:Secret {id: 'arn:aws:secretsmanager:ap-northeast-1:111122223333:secret:rds-db-AbCdEf', arn: 'arn:aws:secretsmanager:ap-northeast-1:111122223333:secret:rds-db-AbCdEf', name: 'rds-db'})
CREATE (images:AWSS3Bucket:S3Bucket {id: 'logssey-prod-s3-images', arn: 'arn:aws:s3:::logssey-prod-s3-images', name: 'logssey-prod-s3-images'})
CREATE (other:AWSS3Bucket:S3Bucket {id: 'someone-else-data', arn: 'arn:aws:s3:::someone-else-data', name: 'someone-else-data'})
CREATE (tfstate:AWSS3Bucket:S3Bucket {id: 'logssey-prod-s3-tfstate', arn: 'arn:aws:s3:::logssey-prod-s3-tfstate', name: 'logssey-prod-s3-tfstate'})
CREATE (k8sNode:KubernetesNode {id: 'logssey-prod/worker-1', name: 'worker-1'})
CREATE (dns)-[:DNS_POINTS_TO]->(nlb)
CREATE (nlb)-[:ELBV2_LISTENER]->(listener)
CREATE (nlb)-[:MEMBER_OF_EC2_SECURITY_GROUP]->(sg)
CREATE (egress)-[:MEMBER_OF_EC2_SECURITY_GROUP]->(sg)
CREATE (anywhere)-[:MEMBER_OF_IP_RULE]->(egress)
CREATE (nlb)-[:EXPOSE {port: 30080}]->(w1)
CREATE (nlb)-[:EXPOSE {port: 30080}]->(w2)
CREATE (internal)-[:EXPOSE {port: 6443}]->(cp)
CREATE (w1)-[:INSTANCE_PROFILE]->(profile)
CREATE (w2)-[:INSTANCE_PROFILE]->(profile)
CREATE (cp)-[:INSTANCE_PROFILE]->(profile)
CREATE (profile)-[:ASSOCIATED_WITH]->(role)
CREATE (role)-[:CAN_READ]->(secret)
CREATE (role)-[:CAN_READ]->(images)
CREATE (role)-[:CAN_READ]->(other)
// 지난 실행이 남긴 보강 관계 (이번에 다시 확인되지 않으면 지워져야 함)
CREATE (w2)-[:HAS_CREDS_OF {_source: 'logssey', lastupdated: -1}]->(role)
