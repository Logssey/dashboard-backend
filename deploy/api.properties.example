# Copy OUTSIDE the repository. Replace host/database/user with approved values.
spring.datasource.url=jdbc:postgresql://replace-db-host:5432/logssey?sslmode=verify-full&sslrootcert=/run/secrets/db-root-ca.crt
spring.datasource.username=logssey_api
# /run/secrets/spring.datasource.password contains only the API DB password.
spring.flyway.enabled=false
spring.jpa.hibernate.ddl-auto=validate
logssey.admin.login-id=replace-bootstrap-login
logssey.admin.display-name=Security Admin
# /run/secrets/logssey.admin.password is required; no password belongs in this file.
server.forward-headers-strategy=framework
server.servlet.session.cookie.secure=true
server.servlet.session.cookie.same-site=lax
server.servlet.session.timeout=60m
server.error.include-message=never
server.error.include-stacktrace=never
logging.level.software.amazon.awssdk=OFF
logging.level.org.apache.hc.client5.http.wire=OFF
logging.level.org.apache.hc.client5.http.headers=OFF
logssey.secret.aws.collection.credentials-mode=WORKLOAD
# Match these capability flags to the worker when enabling an approved pipeline.
logssey.secret.github.enabled=false
logssey.secret.aws.content.enabled=false
logssey.secret.validation.aws.enabled=false
logssey.secret.validation.github.enabled=false
logssey.secret.guide.groq.enabled=false
logssey.notion.collector.token=
logssey.secret.operations.deployment-key=secret-worker
logssey.secret.operations.expected-instances=1
logssey.secret.permissions.enabled=false
# Connection tests use the API's identity only. Give it STS identity access, not source-value access.
# When enabling GitHub connection tests, also mount github-app.pem and set real numeric IDs:
# SECRET_GITHUB_APP_ID=0
# SECRET_GITHUB_INSTALLATION_ID=0
# SECRET_GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
