[Unit]
Description=Logssey encrypted backup and isolated restore drill
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=logssey-backup
Group=logssey-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/logssey-secret-recovery
# Install the tool and its dedicated venv outside an application checkout.
ExecStart=/opt/logssey-recovery/venv/bin/python /opt/logssey-recovery/secret_recovery.py tick --config /etc/logssey-recovery/config.json

[Install]
WantedBy=multi-user.target
