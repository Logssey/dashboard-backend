# 이 파일을 복사해서 .env 를 만들고, change-me 부분을 실제 값으로 바꾼다.
# .env.example 은 GitHub에 올리고, .env 는 절대 올리지 않는다.
# 주의: 값은 영어·숫자로 쓴다. 한글을 쓰면 서버에서 글자가 깨진다.

# 로컬 DB (compose.yaml에서 사용)
DB_NAME=logssey_dashboard
DB_USERNAME=logssey
DB_PASSWORD=change-me
DB_PORT=5432

# 미리 넣어둘 관리자 계정 (ADR-D003)
# 서버를 처음 켤 때 한 번 만들어진다. 이미 있으면 .env를 바꿔도 비밀번호는 그대로다.
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Security Admin

# Notion 페이지 유출 탐지 (선택). 비워 두면 스캔하지 않는다
# 읽기 전용 수집기(Read content만 켠 API token 연결)의 토큰. 실험은 개인 워크스페이스의 테스트 페이지에만 연결한다
NOTION_COLLECTOR_TOKEN=
# 키 지문(HMAC)용 비밀값. 아무 긴 무작위 문자열(영어·숫자). 바꾸면 기존 지문과 비교할 수 없다 (ADR-D009)
CREDENTIAL_FINGERPRINT_SECRET=

# Runtime event collector (local development only; production will use mTLS)
RUNTIME_COLLECTOR_TOKEN=replace-with-a-long-random-local-token
RUNTIME_EXPECTED_WORKER_COUNT=3
RUNTIME_SENSOR_DEGRADED_AFTER=PT2M
RUNTIME_SENSOR_OFFLINE_AFTER=PT5M
