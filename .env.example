# 이 파일을 복사해서 .env 를 만들고, change-me 부분을 실제 값으로 바꾼다.
# .env.example 은 GitHub에 올리고, .env 는 절대 올리지 않는다.
# 주의: 값은 영어·숫자로 쓴다. 한글을 쓰면 서버에서 글자가 깨진다.

# 로컬 DB (compose.yaml에서 사용)
DB_NAME=logssey_dashboard
DB_USERNAME=logssey
DB_PASSWORD=change-me
DB_PORT=5432

# 미리 넣어둘 관리자 계정 (ADR-D003)
# 서버를 처음 켤 때 한 번 만들어진다. 이미 있으면 .env를 바꿔도 비밀번호는 그대로다.
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Security Admin
