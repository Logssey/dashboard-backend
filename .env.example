# 이 파일을 복사해서 .env 를 만들고, change-me 부분을 실제 값으로 바꾼다.
# .env.example 은 GitHub에 올리고, .env 는 절대 올리지 않는다.
# 주의: 값은 영어·숫자로 쓴다. 한글을 쓰면 서버에서 글자가 깨진다.

# 로컬 DB (compose.yaml에서 사용)
DB_NAME=logssey_dashboard
DB_USERNAME=logssey
DB_PASSWORD=change-me
DB_PORT=5432

# 미리 넣어둘 관리자 계정 (ADR-D003)
# 서버를 처음 켤 때 한 번 만들어진다. 이미 있으면 .env를 바꿔도 비밀번호는 그대로다.
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Security Admin

# 시크릿 대응 권한을 명시적으로 부여할 기존 로그인 ID (선택)
# ADMIN이라는 대시보드 역할만으로 시크릿 대응 권한이 생기지 않는다.
# 최초 보안 담당자를 지정한 뒤 서버를 시작하면 별도 권한 부여 이력이 저장된다.
# 한 사람이 두 역할을 맡는 개발 환경에서는 두 ID를 같게 설정할 수 있다.
SECRET_BOOTSTRAP_SECURITY_LOGIN_ID=
SECRET_BOOTSTRAP_REMEDIATOR_LOGIN_ID=
# 조치 담당자가 속한 팀 이름 (선택, 영문/숫자 권장)
SECRET_BOOTSTRAP_REMEDIATOR_TEAM=

# Optional response guide. Select claude (default) or groq. GET never calls an external API.
SECRET_GUIDE_PROVIDER=claude
SECRET_GUIDE_CLAUDE_ENABLED=false
# Set a server environment key or a protected file containing one key. Keep actual values out of Git.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
# A workspace-scoped key can omit this. Personal/all-workspace keys may need their workspace ID.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
# First structured-output calls can compile a schema. Subsequent identical enum contexts use cache.
SECRET_GUIDE_CLAUDE_TIMEOUT_MS=45000
SECRET_GUIDE_CLAUDE_CALLS_PER_MINUTE=6
SECRET_GUIDE_CLAUDE_CACHE_SECONDS=300

# Usage-help chatbot. Prefer a dedicated key from a separate Anthropic workspace with a spend limit.
# When HELP_ANTHROPIC_API_KEY is blank, ANTHROPIC_API_KEY is used; with neither, the Secrets Manager secret
# named by logssey.secret.guide.claude.api-key-secret-id (set in the production api.properties) is read with the
# API's AWS session.
HELP_CLAUDE_ENABLED=true
HELP_ANTHROPIC_API_KEY=
HELP_ANTHROPIC_API_KEY_FILE=
HELP_CLAUDE_TIMEOUT_MS=30000
HELP_LIMIT_USER_PER_MINUTE=5
HELP_LIMIT_USER_PER_DAY=15
HELP_LIMIT_GLOBAL_PER_MINUTE=20
HELP_LIMIT_GLOBAL_PER_DAY=40

# Optional legacy Groq adapter for classified synthetic cases. Select SECRET_GUIDE_PROVIDER=groq.
SECRET_GUIDE_GROQ_ENABLED=false
GROQ_API_KEY=
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_MODEL=openai/gpt-oss-20b

# Notion 페이지 유출 탐지 (선택). 비워 두면 스캔하지 않는다
# 읽기 전용 수집기(Read content만 켠 API token 연결)의 토큰. 실험은 개인 워크스페이스의 테스트 페이지에만 연결한다
NOTION_COLLECTOR_TOKEN=
# 키 지문(HMAC)용 비밀값. 아무 긴 무작위 문자열(영어·숫자). 바꾸면 기존 지문과 비교할 수 없다 (ADR-D009)
CREDENTIAL_FINGERPRINT_SECRET=

# Runtime event collector (local development only; production will use mTLS)
RUNTIME_COLLECTOR_TOKEN=replace-with-a-long-random-local-token
RUNTIME_EXPECTED_WORKER_COUNT=3
RUNTIME_SENSOR_DEGRADED_AFTER=PT2M
RUNTIME_SENSOR_OFFLINE_AFTER=PT5M
